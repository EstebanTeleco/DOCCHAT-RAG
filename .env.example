# --- Embeddings (Ollama, local) ---
# URL de tu instancia de Ollama. Si corrés dentro de Docker, docker-compose
# la sobreescribe automáticamente apuntando al servicio "ollama".
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Chat / generación (Groq) ---
# Se saca gratis en https://console.groq.com
GROQ_API_KEY=tu-api-key-de-groq-aqui
GROQ_BASE_URL=https://api.groq.com/openai/v1
CHAT_MODEL=openai/gpt-oss-120b
# --- Frontend (Streamlit) ---
# Dirección donde corre la API de FastAPI. En Docker, docker-compose
# la sobreescribe apuntando al servicio "api".
API_URL=http://localhost:8000
